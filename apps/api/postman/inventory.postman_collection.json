    {
      "name": "Inventory receipts and idempotency (admin)",
      "item": [
        {
          "name": "Receive 10",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{receiptKey}}"
              }
            ],
            "url": "{{baseUrl}}/inventory/{{productId}}/movements",
            "body": {
              "mode": "raw",
              "raw": "{\"type\": \"RECEIPT\", \"quantity\": 10, \"reason\": \"Opening stock\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Manually populate an empty environment key once. Replays reuse it; never generate a fresh key for retry. Duplicate raw headers require curl/raw HTTP; add the same header twice when the client preserves occurrences. In-flight duplicate: hold original balance lock in disposable PostgreSQL, send same key, expect immediate 409 and Retry-After 1."
          }
        },
