NODE_ENV=development
REFRESH_TOKEN_CLEANUP_ENABLED=true
REFRESH_TOKEN_CLEANUP_CRON="0 0 * * * *"
REFRESH_TOKEN_CLEANUP_BATCH_SIZE=1000
REFRESH_TOKEN_CLEANUP_MAX_BATCHES=20
REFRESH_TOKEN_CLEANUP_RETENTION_DAYS=0
PORT=3001
DATABASE_URL=postgresql://inventory:inventory_dev@localhost:5432/inventory
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-this-with-a-random-32-character-minimum-secret
JWT_ISSUER=inventory-api
JWT_AUDIENCE=inventory-api
APP_ORIGIN=http://localhost:3002
# Create a Google OAuth Web application before enabling Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3004/api/v1/auth/google/callback
